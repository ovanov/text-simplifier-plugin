{
  "manifest_version": 3,
  "name": "EinfachLesen",
  "version": "1.1.0",
  "description": "Vereinfacht deutsche Nachrichtenartikel für L2-Lernende (Forschungsstudie der Universität Zürich).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.srf.ch/*",
    "https://*.20min.ch/*",
    "__BACKEND_URL_HOST__"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.srf.ch/*",
        "https://*.20min.ch/*"
      ],
      "js": ["dist/content.js"],
      "css": ["style.css"]
    }
  ]
}
